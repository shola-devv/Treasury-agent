# --- KeeperHub ---
# Create at app.keeperhub.com > Settings > API Keys > Organisation tab
KEEPERHUB_API_KEY=kh_your_key_here
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# Sepolia chain id (KeeperHub accepts chain ids as strings)
CHAIN_ID=11155111

# Your KeeperHub org wallet address (auto-created via Turnkey when you set up the org).
# This is the TREASURY / destination wallet.
TREASURY_WALLET_ADDRESS=0xYourTreasuryWalletHere

# Three throwaway EOAs you generate yourself (MetaMask, cast wallet new, etc).
# Fund each with a small amount of Sepolia faucet ETH. These simulate "inflow" wallets.
# The agent READS these directly via public RPC (no auth needed) to decide.
# To actually SWEEP funds out of them, KeeperHub's org wallet must be able to sign for
# them — simplest path is to import each inflow wallet's private key into KeeperHub as
# an additional wallet integration (see README "Wallet setup" step). Never commit real
# private keys; on Sepolia these are throwaway/faucet-funded only.
INFLOW_WALLET_1=0xYourInflowWallet1
INFLOW_WALLET_2=0xYourInflowWallet2
INFLOW_WALLET_3=0xYourInflowWallet3

# --- Groq (reasoning layer) ---
# Free tier, no credit card: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Agent behavior ---
# Minimum ETH balance in an inflow wallet worth sweeping, after estimated gas.
SWEEP_THRESHOLD_ETH=0.001
POLL_INTERVAL_SECONDS=600
