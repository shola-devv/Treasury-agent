 --- KeeperHub ---
# Create at app.keeperhub.com > Settings > API Keys > Organisation tab
KEEPERHUB_API_KEY=kh_your_key_here
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# Sepolia chain id (KeeperHub accepts chain ids as strings)
CHAIN_ID=11155111

# Your KeeperHub org wallet address (auto-created via Turnkey when you set up the org).
# This is the ONLY wallet KeeperHub can actually sign transactions from — it cannot
# sign from arbitrary wallets you hold private keys for. This is your funding source.
TREASURY_WALLET_ADDRESS=0xYourTreasuryWalletHere

# Three destination wallets (payout/reward recipients). These just need to be valid
# addresses — you can reuse the 3 throwaway wallets from earlier, no private keys
# needed for them anymore since KeeperHub only ever sends FROM the treasury wallet.
PAYOUT_WALLET_1=0xYourPayoutWallet1
PAYOUT_WALLET_2=0xYourPayoutWallet2
PAYOUT_WALLET_3=0xYourPayoutWallet3

# --- Groq (reasoning layer) ---
# Free tier, no credit card: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Agent behavior ---
# Fixed payout amount per wallet per cycle. Keep this small so your treasury
# balance lasts through many demo runs (e.g. 0.15 ETH / 0.002 = 75 payouts).
DISBURSEMENT_AMOUNT_ETH=0.002
# Minimum net benefit (disbursement - gas) worth acting on.
SWEEP_THRESHOLD_ETH=0.0005
POLL_INTERVAL_SECONDS=600
